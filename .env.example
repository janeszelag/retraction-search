# Copy this file to .env.local and fill in the values. .env.local stays out of git.

# Typesense's admin key. `npm run search:up` starts Typesense with it, and only
# `npm run load` uses it. Any long random string works locally, for example
# the output of `openssl rand -hex 32`.
TYPESENSE_ADMIN_KEY=

# Where the site and the load command reach Typesense.
TYPESENSE_URL=http://localhost:8108

# The site's read-only key (search and export). `npm run load` creates it and saves it here.
TYPESENSE_SEARCH_KEY=

# Where the site keeps per-visitor rate-limit counters.
REDIS_URL=redis://localhost:6379

# Mixed into each visitor's address before hashing, so the counters don't hold
# addresses. Any long random string, for example `openssl rand -hex 32`.
VISITOR_HASH_SALT=

# Optional: lower the per-visitor limits for testing. Defaults: 60 searches a
# minute and 6 downloads an hour.
# RATE_LIMIT_SEARCHES=5
# RATE_LIMIT_DOWNLOADS=2
